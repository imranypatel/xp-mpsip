@page "/login"
@layout AuthLayout
@inject AuthService AuthSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject ISnackbar Snackbar

<PageTitle>Sign In — MPSIP</PageTitle>

<EditForm Model="_model" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <MudText Typo="Typo.h6" Class="mb-4">Sign In</MudText>
    <MudTextField @bind-Value="_model.Email" Label="Email" InputType="InputType.Email"
                  Variant="Variant.Outlined" Class="mb-3" Required="true" />
    <MudTextField @bind-Value="_model.Password" Label="Password" InputType="InputType.Password"
                  Variant="Variant.Outlined" Class="mb-4" Required="true" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               FullWidth="true" Disabled="_loading">
        @(_loading ? "Signing in…" : "Sign In")
    </MudButton>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-3">
        Don't have an account? <MudLink Href="/register">Register</MudLink>
    </MudText>
</EditForm>

@code {
    readonly LoginModel _model = new();
    bool _loading;

    async Task HandleLogin()
    {
        _loading = true;
        var dto = new MPSIP.Application.DTOs.LoginDto(_model.Email, _model.Password);
        var user = await AuthSvc.LoginAsync(dto);
        if (user == null)
        {
            Snackbar.Add("Invalid email or password.", Severity.Error);
            _loading = false;
            return;
        }
        await HttpCtx.HttpContext!.SignInWithMpsipUserAsync(user);
        Nav.NavigateTo("/dashboard", forceLoad: true);
    }

    class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
