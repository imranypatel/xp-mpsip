@page "/projects/{ProjectId:int}/contributions/log"
@attribute [Authorize]
@inject ContributionService ContribSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Log Contribution — MPSIP</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Log Contribution</MudText>

<MudPaper Class="pa-6" Elevation="2" Style="max-width:560px">
    <EditForm Model="_model" OnValidSubmit="HandleLog">
        <MudSelect @bind-Value="_model.ResourceType" Label="Type" Variant="Variant.Outlined" Class="mb-3" Required="true">
            <MudSelectItem Value="@("Man")">Man (Time / Effort)</MudSelectItem>
            <MudSelectItem Value="@("Material")">Material (Goods / Inventory)</MudSelectItem>
            <MudSelectItem Value="@("Money")">Money (Cash Outlay)</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Class="mb-3" Required="true" />
        <MudNumericField @bind-Value="_model.Quantity" Label="Quantity" Variant="Variant.Outlined" Class="mb-3" Required="true" />
        <MudTextField @bind-Value="_model.Unit" Label="Unit (hrs, kg, pcs…)" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField @bind-Value="_model.MonetaryValue" Label="Monetary Value" Variant="Variant.Outlined" Class="mb-3" />
        <MudDatePicker @bind-Date="_date" Label="Date" Variant="Variant.Outlined" Class="mb-4" />
        <MudStack Row="true">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">
                @(_saving ? "Saving…" : "Log Contribution")
            </MudButton>
            <MudButton Variant="Variant.Text" Href="@($"/projects/{ProjectId}/contributions")">Cancel</MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public int ProjectId { get; set; }
    readonly ContribModel _model = new();
    DateTime? _date = DateTime.Today;
    bool _saving;

    async Task HandleLog()
    {
        _saving = true;
        var auth = await AuthState.GetAuthenticationStateAsync();
        int userId = int.Parse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
        var cmd = new LogContributionCommand(ProjectId, null, userId, _model.ResourceType,
            _model.Description, _model.Quantity, _model.Unit, _model.MonetaryValue,
            DateOnly.FromDateTime(_date ?? DateTime.Today));
        await ContribSvc.LogAsync(cmd);
        Snackbar.Add("Contribution logged.", Severity.Success);
        Nav.NavigateTo($"/projects/{ProjectId}/contributions");
    }

    class ContribModel
    {
        public string ResourceType { get; set; } = "Man";
        public string Description { get; set; } = "";
        public decimal Quantity { get; set; } = 1;
        public string? Unit { get; set; }
        public decimal? MonetaryValue { get; set; }
    }
}
