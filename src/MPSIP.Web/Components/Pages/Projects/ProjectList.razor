@page "/projects"
@attribute [Authorize]
@inject ProjectService ProjectSvc
@inject AuthenticationStateProvider AuthState

<PageTitle>Projects — MPSIP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Projects</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/projects/create"
               StartIcon="@Icons.Material.Filled.Add">New Project</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!_projects.Any())
{
    <MudPaper Class="pa-8 text-center" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6" Class="mt-2 mb-1">No projects yet</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/projects/create"
                   StartIcon="@Icons.Material.Filled.Add">Create First Project</MudButton>
    </MudPaper>
}
else
{
    <MudTable Items="_projects" Hover="true" Striped="true" Elevation="2"
              Filter="item => FilterFunc(item)">
        <ToolBarContent>
            <MudTextField @bind-Value="_searchText" Placeholder="Search projects…"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Clearable="true" Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Start Date</MudTh>
            <MudTh>Expected End</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.StatusCode)">@context.StatusCode</MudChip></MudTd>
            <MudTd>@context.StartDate.ToShortDateString()</MudTd>
            <MudTd>@context.ExpectedEndDate.ToShortDateString()</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Href="@($"/projects/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Href="@($"/projects/{context.Id}/edit")" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    List<MPSIP.Domain.Entities.Project> _projects = [];
    bool _loading = true;
    string _searchText = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var idClaim = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (idClaim != null && int.TryParse(idClaim.Value, out int userId))
            _projects = (await ProjectSvc.ListByOwnerAsync(userId)).ToList();
        _loading = false;
    }

    bool FilterFunc(MPSIP.Domain.Entities.Project p) =>
        string.IsNullOrEmpty(_searchText) ||
        p.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase);

    static Color StatusColor(string s) => s switch
    {
        "Active" => Color.Success, "Closing" => Color.Warning,
        "Closed" or "Archived" => Color.Default, _ => Color.Info
    };
}
