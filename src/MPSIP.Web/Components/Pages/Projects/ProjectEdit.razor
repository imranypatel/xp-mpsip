@page "/projects/{Id:int}/edit"
@attribute [Authorize]
@inject ProjectService ProjectSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Edit Project — MPSIP</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Edit Project</MudText>

@if (_loading) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudPaper Class="pa-6" Elevation="2" Style="max-width:600px">
        <EditForm Model="_model" OnValidSubmit="HandleSave">
            <MudTextField @bind-Value="_model.Name" Label="Project Name" Variant="Variant.Outlined" Class="mb-3" Required="true" />
            <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Lines="3" Class="mb-3" />
            <MudDatePicker @bind-Date="_startDate" Label="Start Date" Variant="Variant.Outlined" Class="mb-3" />
            <MudDatePicker @bind-Date="_endDate" Label="Expected End Date" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_model.RiskDeclaration" Label="Risk Declaration" Variant="Variant.Outlined" Lines="2" Class="mb-3" />
            <MudTextField @bind-Value="_model.Contingency" Label="Contingency Plan" Variant="Variant.Outlined" Lines="2" Class="mb-4" />
            <MudStack Row="true">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">
                    @(_saving ? "Saving…" : "Save Changes")
                </MudButton>
                <MudButton Variant="Variant.Text" Href="@($"/projects/{Id}")">Cancel</MudButton>
            </MudStack>
        </EditForm>
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }
    EditModel _model = new();
    DateTime? _startDate, _endDate;
    bool _loading = true, _saving;

    protected override async Task OnInitializedAsync()
    {
        var p = await ProjectSvc.GetByIdAsync(Id);
        if (p is not null)
        {
            _model = new EditModel
            {
                Name = p.Name, Description = p.Description,
                RiskDeclaration = p.RiskDeclaration, Contingency = p.Contingency
            };
            _startDate = p.StartDate.ToDateTime(TimeOnly.MinValue);
            _endDate = p.ExpectedEndDate.ToDateTime(TimeOnly.MinValue);
        }
        _loading = false;
    }

    async Task HandleSave()
    {
        _saving = true;
        var auth = await AuthState.GetAuthenticationStateAsync();
        int userId = int.Parse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
        var cmd = new UpdateProjectCommand(Id, _model.Name, _model.Description,
            DateOnly.FromDateTime(_startDate ?? DateTime.Today),
            DateOnly.FromDateTime(_endDate ?? DateTime.Today),
            _model.RiskDeclaration, _model.Contingency, userId);
        await ProjectSvc.UpdateAsync(cmd);
        Snackbar.Add("Project updated.", Severity.Success);
        Nav.NavigateTo($"/projects/{Id}");
    }

    class EditModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? RiskDeclaration { get; set; }
        public string? Contingency { get; set; }
    }
}
